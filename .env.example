# Local PostgreSQL configuration for prices_b3.
# These defaults match the optional docker-compose.yml service.
# Never commit a real .env file with non-local credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=prices_b3
PGUSER=postgres
PGPASSWORD=postgres
# Optional: set to 1 to run the PostgreSQL smoke test during local unittest runs.
# PRICES_B3_RUN_DB_TESTS=1
